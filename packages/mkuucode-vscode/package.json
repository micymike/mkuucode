{
  "name": "mkuucode-vscode",
  "displayName": "MkuuCode",
  "description": "VS Code integration for MkuuCode built on OpenCode agent engine.",
  "version": "0.2.2",
  "publisher": "MichaelMoses",
  "icon": "resources/icon.png",
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onView:mkuucode.chatView",
    "onCommand:mkuucode.open",
    "onCommand:mkuucode.plan",
    "onCommand:mkuucode.review",
    "onCommand:mkuucode.test",
    "onCommand:mkuucode.explain",
    "onCommand:mkuucode.fix",
    "onCommand:mkuucode.explainSelection",
    "onCommand:mkuucode.fixSelection",
    "onCommand:mkuucode.focusInput",
    "onCommand:mkuucode.exportChat"
  ],
  "main": "./dist/extension.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/micymike/mkuucode"
  },
  "repositoryName": "mkuucode",
  "homepage": "https://github.com/micymike/mkuucode",
  "qna": "markdown",
  "contributes": {
    "commands": [
      { "command": "mkuucode.open", "title": "MkuuCode: Open" },
      { "command": "mkuucode.plan", "title": "MkuuCode: /plan" },
      { "command": "mkuucode.review", "title": "MkuuCode: /review" },
      { "command": "mkuucode.test", "title": "MkuuCode: /test" },
      { "command": "mkuucode.explain", "title": "MkuuCode: /explain" },
      { "command": "mkuucode.fix", "title": "MkuuCode: /fix" },
      { "command": "mkuucode.explainSelection", "title": "MkuuCode: Explain Selection" },
      { "command": "mkuucode.fixSelection", "title": "MkuuCode: Fix Selection" },
      { "command": "mkuucode.focusInput", "title": "MkuuCode: Focus Input" },
      { "command": "mkuucode.exportChat", "title": "MkuuCode: Export Chat" }
    ],
    "keybindings": [
      {
        "command": "mkuucode.focusInput",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mkuucode.explainSelection",
          "when": "editorHasSelection",
          "group": "mkuucode@1"
        },
        {
          "command": "mkuucode.fixSelection",
          "when": "editorHasSelection",
          "group": "mkuucode@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mkuucode-sidebar",
          "title": "MkuuCode",
          "icon": "resources/icon.png"
        }
      ]
    },
    "views": {
      "mkuucode-sidebar": [
        {
          "type": "webview",
          "id": "mkuucode.chatView",
          "name": "MkuuCode Chat"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "tsc": "node build.js",
    "package": "node release.mjs"
  },
"dependencies": {},
  "devDependencies": {
    "@opencode-ai/sdk": "workspace:*",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "highlight.js": "^11.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.0.0"
  }
}